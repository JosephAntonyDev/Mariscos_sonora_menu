---
import '@fontsource-variable/baloo-2';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import balooLatin from '@fontsource-variable/baloo-2/files/baloo-2-latin-wght-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import { negocio } from '../data/negocio';

interface Props {
  titulo?: string;
  descripcion?: string;
  indexar?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Imagen para compartir (ruta pública) y sus medidas. */
  imagen?: { ruta: string; ancho: number; alto: number; alt: string };
}
const {
  titulo = `${negocio.nombre} · Menú`,
  descripcion = `Menú de ${negocio.nombre}: ceviche con mango, aguachile, tostadas, Clamato preparado y más. Pedidos por WhatsApp al ${negocio.telefono.visible}. ${negocio.ciudad}.`,
  indexar = true,
  jsonLd,
  imagen = { ruta: '/og-image.jpg', ancho: 1200, alto: 630, alt: `Logo de ${negocio.nombre}` },
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(imagen.ruta, Astro.site);
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {!indexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0E4A57" />

    <link rel="preload" href={balooLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imagen.ancho)} />
    <meta property="og:image:height" content={String(imagen.alto)} />
    <meta property="og:image:alt" content={imagen.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
