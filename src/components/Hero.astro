---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-insignia.png';
import Icono from './Icono.astro';
import EstadoHorario from './EstadoHorario.tsx';
import { negocio, waLink } from '../data/negocio';
import { horarioAgrupado } from '../lib/horario';

const resumen = horarioAgrupado(negocio.horario)
  .map((g) => `${g.dias}: ${g.horas.toLowerCase()}`)
  .join(' · ');
---
<header class="hero">
  <div class="hero__mar" aria-hidden="true"></div>
  <div class="contenedor hero__in">
    <Image
      src={logo}
      alt={`Logo de ${negocio.nombre}: camarón con sombrero sobre una moneda de cobre`}
      class="hero__logo"
      width={520}
      widths={[180, 260, 360, 520]}
      sizes="(min-width: 860px) 260px, 180px"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__texto">
      <p class="hero__ciudad">{negocio.ciudad}</p>
      <h1 class="hero__titulo">
        <span class="hero__pre">Mariscos</span>
        El Chiapas Sonora
      </h1>
      <p class="hero__lema">{negocio.lema}</p>
      <EstadoHorario
        client:idle
        horario={negocio.horario}
        zona={negocio.zonaHoraria}
        cierreAgotar={negocio.cierreEstimadoAgotar}
        resumen={resumen}
      />
      <div class="hero__ctas">
        <a class="boton boton--primario" href={waLink('¡Hola! Quiero hacer un pedido 🦐')} target="_blank" rel="noopener">
          <Icono nombre="whatsapp" /> Pedir por WhatsApp
        </a>
        <a class="boton boton--fantasma" href={`tel:${negocio.telefono.tel}`}>
          <Icono nombre="telefono" /> {negocio.telefono.visible}
        </a>
      </div>
      <a class="hero__carta" href="/carta">
        <Icono nombre="carta" tam={18} /> Ver la carta completa <span>· imprimir o compartir</span>
      </a>
    </div>
  </div>
  <svg class="hero__ola" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 40c120 22 240 33 360 22S600 18 720 22s240 40 360 40 240-24 360-36v54H0Z" fill="var(--arena)" />
  </svg>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    color: #fff;
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(233 211 164 / 22%), transparent 60%),
      linear-gradient(160deg, var(--mar-claro) 0%, var(--mar) 62%, #0a3540 100%);
    padding: clamp(28px, 6vw, 64px) 0 clamp(64px, 9vw, 104px);
    overflow: hidden;
  }
  /* Textura sutil de olas, dibujada con CSS (sin imagen extra). */
  .hero__mar {
    position: absolute; inset: 0; z-index: -1; opacity: .09;
    background-image: radial-gradient(circle at 50% 120%, transparent 38%, #fff 39%, #fff 41%, transparent 42%);
    background-size: 64px 26px;
    mask-image: linear-gradient(to bottom, transparent, #000 50%, transparent);
  }
  .hero__in {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
  }
  .hero__logo {
    width: 180px; height: auto; aspect-ratio: 1;
    filter: drop-shadow(0 18px 28px rgb(0 0 0 / 35%));
  }
  .hero__ciudad {
    font: 800 .75rem/1 var(--f-texto); letter-spacing: .16em; text-transform: uppercase;
    color: var(--oro-claro);
  }
  .hero__titulo {
    margin-top: 8px;
    font-size: clamp(2.5rem, 9vw, 4.25rem);
    font-weight: 800;
    line-height: .95;
    letter-spacing: -.01em;
    text-shadow: 0 2px 0 var(--cafe), 0 6px 18px rgb(0 0 0 / 25%);
  }
  .hero__pre {
    display: block; margin-bottom: 6px;
    font-size: .38em; letter-spacing: .3em; text-transform: uppercase; color: var(--oro-claro); text-shadow: none;
  }
  .hero__lema { max-width: 36ch; margin: 12px auto 0; font-size: 1.0625rem; color: rgb(255 255 255 / 88%); }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 18px; }
  .hero__carta {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 6px;
    font-weight: 800; color: var(--oro-claro); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1.5px;
  }
  .hero__carta span { font-weight: 600; color: rgb(255 255 255 / 75%); text-decoration: none; }
  @media (max-width: 380px) { .hero__carta span { display: none; } }
  .hero__ola { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(36px, 6vw, 80px); }

  .hero :global(.estado) {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;
    padding: 8px 14px; border-radius: 999px;
    background: rgb(255 255 255 / 12%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 22%);
    font-size: .9rem; font-weight: 700; max-width: 100%;
  }
  .hero :global(.estado__punto) { width: 9px; height: 9px; border-radius: 50%; background: var(--oro-claro); flex: none; }
  .hero :global(.estado--abierto .estado__punto) { background: #5ee08f; box-shadow: 0 0 0 4px rgb(94 224 143 / 25%); }
  .hero :global(.estado--cerrado .estado__punto) { background: #ff9b7a; }

  @media (min-width: 860px) {
    .hero__in { grid-template-columns: auto 1fr; justify-items: start; text-align: left; gap: 48px; align-items: center; }
    .hero__logo { width: 260px; }
    .hero__lema { margin-inline: 0; }
    .hero__ctas { justify-content: flex-start; }
  }
</style>
