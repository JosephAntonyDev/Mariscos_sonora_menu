---
import Icono from './Icono.astro';
import { negocio } from '../data/negocio';
const urlCarta = new URL('/carta', Astro.site).href;
const texto = `Mira la carta de ${negocio.nombre} 🦐\n${urlCarta}`;
---
<section class="cbanner contenedor" aria-labelledby="cbanner-titulo">
  <a class="cbanner__vista" href="/carta" tabindex="-1" aria-hidden="true">
    <img src="/descargas/carta-post-arena-vista.webp" alt="" width="360" height="450" loading="lazy" />
  </a>
  <div class="cbanner__texto">
    <span class="eyebrow">Carta para imprimir o compartir</span>
    <h2 id="cbanner-titulo">Toda la carta en una sola hoja</h2>
    <p>Ideal para imprimir, guardar como PDF o mandarla por WhatsApp. También hay imágenes listas para estados e historias.</p>
    <div class="cbanner__acciones">
      <a class="boton boton--primario" href="/carta"><Icono nombre="carta" /> Ver la carta</a>
      <a class="boton boton--claro" href={`https://wa.me/?text=${encodeURIComponent(texto)}`} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" /> Compartir por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cbanner {
    display: grid; gap: 20px; align-items: center; margin-top: clamp(36px, 6vw, 56px);
    padding: clamp(18px, 4vw, 28px); border-radius: var(--radio);
    background: linear-gradient(135deg, var(--papel), var(--arena-2)); box-shadow: var(--sombra);
  }
  @media (min-width: 680px) { .cbanner { grid-template-columns: 220px 1fr; gap: 32px; } }
  .cbanner__vista { display: block; max-width: 220px; margin-inline: auto; transform: rotate(-2.5deg); transition: transform .3s ease; }
  .cbanner__vista:hover { transform: rotate(0) scale(1.02); }
  .cbanner__vista img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 18px 40px -18px rgb(59 32 20 / 55%); }
  .cbanner h2 { font-size: clamp(1.6rem, 4.5vw, 2.1rem); color: var(--mar); margin-top: 2px; }
  .cbanner p { color: var(--tinta-suave); margin-top: 6px; max-width: 52ch; }
  .cbanner__acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
</style>
